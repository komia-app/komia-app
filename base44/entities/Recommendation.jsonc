{
  "name": "Recommendation",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "restaurant_id": {
      "type": "string"
    },
    "score": {
      "type": "number"
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "type": "string",
      "enum": [
        "mia_profile",
        "trending",
        "social",
        "editorial"
      ],
      "default": "mia_profile"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "viewed",
        "saved",
        "dismissed",
        "visited"
      ],
      "default": "new"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "model_version": {
      "type": "string",
      "default": "mia-mvp-rules-v1"
    },
    "feedback": {
      "type": "string",
      "enum": [
        "like",
        "dislike",
        "none"
      ],
      "default": "none"
    }
  },
  "required": [
    "user_id",
    "restaurant_id",
    "score"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
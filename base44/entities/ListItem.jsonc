{
  "name": "ListItem",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "list_id": {
      "type": "string"
    },
    "restaurant_id": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "want_to_try": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "user_id",
    "list_id",
    "restaurant_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}